    /* -- PLAYGROUND MODULE 1: NEURAL NET -- */
    let neuralPoints = [];
    let trainingInterval = null;
    let isTrainingNN = false;
    let nnEpochCount = 0;
    let nnLossValue = 0.654;
    let datasetMode = "linear";
    let learningRateNN = 0.1;

    function initDraftPoints() {
      neuralPoints = [];
      const space = document.getElementById('neural-mesh-space');
      space.querySelectorAll('.scatter-point').forEach(p => p.remove());

      if (datasetMode === 'linear') {
        for (let i = 0; i < 28; i++) {
          neuralPoints.push({ x: Math.random() * 40 + 8, y: Math.random() * 40 + 8, label: 0 });
