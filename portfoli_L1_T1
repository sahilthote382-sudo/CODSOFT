      alertBox.classList.add('hidden');

      if (!rawText.includes('select') || !rawText.includes('from student_stats')) {
        alertBox.className = "p-3 bg-red-50 border border-red-200 text-red-800 text-xs rounded-xl flex items-center gap-2";
        alertText.innerText = "Error: Applet parser only queries SELECT column FROM STUDENT_STATS";
        alertBox.classList.remove('hidden');
        return;
      }

      let queryResults = [...studentDB];

      // where filters
      if (rawText.includes('where')) {
        if (rawText.includes('raw_gpa >= 8.4') || rawText.includes('gpa >= 8.4')) {
          queryResults = queryResults.filter(r => r.raw_gpa >= 8.40);
        } else if (rawText.includes('class_rank <= 12')) {
          queryResults = queryResults.filter(r => r.class_rank <= 12);
        } else if (rawText.includes('sahil')) {
          queryResults = queryResults.filter(r => r.name.includes('Sahil'));
        }
      }

      // order sorting
      if (rawText.includes('order by')) {
        if (rawText.includes('asc')) {
          queryResults.sort((a,b) => a.class_rank - b.class_rank);
        } else if (rawText.includes('desc')) {
          queryResults.sort((a,b) => b.class_rank - a.class_rank);
        }
      }

      alertBox.className = "p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs rounded-xl flex items-center gap-2";
      alertText.innerText = `SQL query ran successfully: returned ${queryResults.length} rows in 0.35ms.`;
      alertBox.classList.remove('hidden');
      hydrateSQLTable(queryResults);
    }


    /* -- PLAYGROUND MODULE 3: PYTHON SORTING SIM -- */
    let sortingArray = [45, 12, 85, 32, 56, 70, 22, 90, 18, 59];
    let sortInterval = null;
    let isSortingSim = false;
    let selectedSortAlgorithm = "bubble";

    function hydrateSortingBars(comparingIndices = [], sortedIndices = []) {
      const frame = document.getElementById('py-bars-visualizer');
      frame.innerHTML = "";

      sortingArray.forEach((val, idx) => {
        const wrap = document.createElement('div');
        wrap.className = "flex-1 flex flex-col items-center gap-1.5";

        let textClass = "text-[10px] font-mono ";
        let barClass = "w-full rounded-t-md transition-all duration-205 h-full ";

        if (comparingIndices.includes(idx)) {
          textClass += "text-indigo-600 font-bold";
          barClass += "bg-gradient-to-t from-indigo-505 to-indigo-650 shadow bg-indigo-500";
        } else if (sortedIndices.includes(idx)) {
          textClass += "text-emerald-600 font-bold";
          barClass += "bg-gradient-to-t from-emerald-505 to-emerald-650 bg-emerald-500";
        } else {
          textClass += "text-neutral-450";
          barClass += "bg-neutral-250 bg-neutral-300";
        }

        wrap.innerHTML = `
          <span class="${textClass}">${val}</span>
          <div class="${barClass}" style="height: ${(val / 100) * 140}px"></div>
        `;
        frame.appendChild(wrap);
      });
    }

    function setSortingAlgo(alg) {
      if (isSortingSim) return;
      selectedSortAlgorithm = alg;
      document.getElementById('py-btn-bubble').className = alg === 'bubble' ? "py-2 text-[11px] font-mono font-bold border rounded-lg bg-[#1c1c1a] text-white" : "py-2 text-[11px] font-mono font-bold border rounded-lg bg-white border-[#d4d4cb] text-neutral-600";
      document.getElementById('py-btn-selection').className = alg === 'selection' ? "py-2 text-[11px] font-mono font-bold border rounded-lg bg-[#1c1c1a] text-white" : "py-2 text-[11px] font-mono font-bold border rounded-lg bg-white border-[#d4d4cb] text-neutral-600";

      document.getElementById('bubble-code-block').classList.toggle('hidden', alg !== 'bubble');
      document.getElementById('selection-code-block').classList.toggle('hidden', alg !== 'selection');
    }

    function shuffleSortingArray() {
      if (isSortingSim) return;
      sortingArray = Array.from({ length: 10 }, () => Math.floor(Math.random() * 85) + 12);
      document.querySelectorAll(".py-cl").forEach(l => l.style.backgroundColor = 'transparent');
      hydrateSortingBars();
    }

    function runSortingPlayback() {
      if (isSortingSim) return;
      isSortingSim = true;

      let subSteps = [];
      let tempArr = [...sortingArray];
      const n = tempArr.length;

      if (selectedSortAlgorithm === 'bubble') {
        for (let i = 0; i < n; i++) {
          for (let j = 0; j < n - i - 1; j++) {
            subSteps.push({ arr: [...tempArr], act: [j, j + 1], line: 3 });
            subSteps.push({ arr: [...tempArr], act: [j, j + 1], line: 5 });
            if (tempArr[j] > tempArr[j + 1]) {
              const t = tempArr[j];
              tempArr[j] = tempArr[j + 1];
              tempArr[j + 1] = t;
              subSteps.push({ arr: [...tempArr], act: [j, j + 1], line: 6 });
            }
          }
          subSteps.push({ arr: [...tempArr], act: [], line: 2, sortedUpTo: n - i - 1 });
        }
      } else {
        // selection sort step compiler
        for (let i = 0; i < n; i++) {
          let minIdx = i;
          subSteps.push({ arr: [...tempArr], act: [i], line: 3 });
          for (let j = i + 1; j < n; j++) {
            subSteps.push({ arr: [...tempArr], act: [i, j, minIdx], line: 5 });
            if (tempArr[j] < tempArr[minIdx]) {
              minIdx = j;
              subSteps.push({ arr: [...tempArr], act: [i, j, minIdx], line: 7 });
            }
          }
          // swap
          const t = tempArr[i];
          tempArr[i] = tempArr[minIdx];
          tempArr[minIdx] = t;
          subSteps.push({ arr: [...tempArr], act: [i, minIdx], line: 8, sortedUpTo: i });
        }
      }

      let idx = 0;
      let sortedLocked = [];
      document.getElementById('py-play-btn').setAttribute('disabled', 'true');

      sortInterval = setInterval(() => {
        if (idx >= subSteps.length) {
          clearInterval(sortInterval);
          isSortingSim = false;
          hydrateSortingBars([], Array.from({ length: 10 }, (_, k) => k));
          document.querySelectorAll(".py-cl").forEach(l => l.style.backgroundColor = 'transparent');
          document.getElementById('py-play-btn').removeAttribute('disabled');
          return;
        }

        const step = subSteps[idx];
        sortingArray = step.arr;
        if (step.sortedUpTo !== undefined) {
          sortedLocked.push(step.sortedUpTo);
        }

        hydrateSortingBars(step.act, sortedLocked);

        // Highlight line
        document.querySelectorAll(".py-cl").forEach(l => l.style.backgroundColor = 'transparent');
        const prefix = selectedSortAlgorithm === 'bubble' ? 'by' : 'sy';
        const lineEl = document.getElementById(`${prefix}-cl-${step.line}`);
        if (lineEl) {
          lineEl.style.backgroundColor = '#1e1b4b'; // dark purple highlight
        }

        idx++;
      }, 350);
    }


    /* ==========================================================================
       D. COLLABORATIVE DIRECT MESSAGES FORM SUBMIT
       ========================================================================== */
    function handleFormTransmission(event) {
      event.preventDefault();
      const btn = document.getElementById('form-submit-btn');
      btn.innerText = "Transmitting message...";
      btn.setAttribute('disabled', 'true');

      setTimeout(() => {
        document.getElementById('portfolio-contact-form').classList.add('hidden');
        document.getElementById('form-success-alert').classList.remove('hidden');
      }, 1400);
    }

    function resetContactForm() {
      // restore default styles
      document.getElementById('form-name').value = "";
      document.getElementById('form-email').value = "";
      document.getElementById('form-message').value = "";
      
      const btn = document.getElementById('form-submit-btn');
      btn.innerText = "Transmit Message";
      btn.removeAttribute('disabled');

      document.getElementById('portfolio-contact-form').classList.remove('hidden');
      document.getElementById('form-success-alert').classList.add('hidden');
    }
  </script>
