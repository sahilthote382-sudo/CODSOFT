      } else {
        for (let i = 0; i < 15; i++) {
          neuralPoints.push({ x: Math.random() * 32 + 8, y: Math.random() * 32 + 60, label: 0 });
          neuralPoints.push({ x: Math.random() * 32 + 60, y: Math.random() * 32 + 8, label: 0 });
          neuralPoints.push({ x: Math.random() * 32 + 8, y: Math.random() * 32 + 8, label: 1 });
          neuralPoints.push({ x: Math.random() * 32 + 60, y: Math.random() * 32 + 60, label: 1 });
        }
      }

      neuralPoints.forEach(pt => {
        const dot = document.createElement('div');
        dot.className = "scatter-point absolute w-3 h-3 rounded-full border border-white shadow-xs -translate-x-1/2 -translate-y-1/2 transition-transform duration-300 hover:scale-130";
        if (pt.label === 0) {
          dot.className += " bg-amber-500";
        } else {
          dot.className += " bg-emerald-500";
        }
        dot.style.left = pt.x + "%";
        dot.style.top = pt.y + "%";
        space.appendChild(dot);
      });
    }

    function setNeuralDataset(mode) {
      stopNNTraining();
      datasetMode = mode;
      document.getElementById('nn-ds-linear').className = mode === 'linear' 
        ? "py-2 text-[11px] font-semibold border rounded-lg bg-[#1c1c1a] text-amber-200 border-black" 
        : "py-2 text-[11px] font-semibold border rounded-lg bg-white border-[#d4d4cb] text-neutral-600 hover:border-black";
      document.getElementById('nn-ds-xor').className = mode === 'xor' 
        ? "py-2 text-[11px] font-semibold border rounded-lg bg-[#1c1c1a] text-amber-200 border-black" 
        : "py-2 text-[11px] font-semibold border rounded-lg bg-white border-[#d4d4cb] text-neutral-600 hover:border-black";

      nnEpochCount = 0;
      nnLossValue = mode === 'linear' ? 0.654 : 0.741;
      document.getElementById('nn-epoch-lbl').innerText = "#0";
      document.getElementById('nn-loss-lbl').innerText = nnLossValue;
      document.getElementById('boundary-gradient-fill').style.opacity = "0.2";
      initDraftPoints();
    }

    function updateLR(val) {
      learningRateNN = parseFloat(val);
      document.getElementById('lr-val-dis').innerText = val;
    }

    function toggleNNTraining() {
      if (isTrainingNN) {
        stopNNTraining();
      } else {
        startNNTraining();
      }
    }

    function startNNTraining() {
      isTrainingNN = true;
      document.getElementById('nn-train-btn').innerHTML = `<i data-lucide="pause" class="w-3.5 h-3.5"></i> Pause Sim`;
      lucide.createIcons();

      trainingInterval = setInterval(() => {
        nnEpochCount++;
        // exponential loss decaying simulations
        let multiplier = datasetMode === 'xor' ? 0.003 : 0.015;
        let delta = learningRateNN * multiplier;
        nnLossValue = Math.max(0.012, nnLossValue - delta);
        nnLossValue = parseFloat((nnLossValue + (Math.random() * 0.002 - 0.001)).toFixed(4));
        
        document.getElementById('nn-epoch-lbl').innerText = "#" + nnEpochCount;
        document.getElementById('nn-loss-lbl').innerText = nnLossValue;

        // adjust visual lines connectivity vibrations
        document.querySelectorAll(".synaptic-wire").forEach(wire => {
          wire.setAttribute('stroke-width', Math.random() * 2 + 0.5);
          wire.setAttribute('stroke', `rgba(245, 158, 11, ${Math.min(0.9, 0.4 + nnEpochCount * 0.01)})`);
        });

        const rot = 135 + Math.min(nnEpochCount, 60) * 0.4;
        const opacityFit = Math.min(0.32, 0.12 + nnEpochCount * 0.004);
        const borderFill = document.getElementById('boundary-gradient-fill');
        if (datasetMode === 'linear') {
          borderFill.style.background = `linear-gradient(${rot}deg, rgba(251, 191, 36, ${opacityFit}) 50%, rgba(16, 185, 129, ${opacityFit}) 50%)`;
        } else {
          borderFill.style.background = `radial-gradient(circle, rgba(251, 191, 36, ${opacityFit}) 45%, rgba(16, 185, 129, ${opacityFit}) 45%)`;
        }
      }, 120);
    }

    function stopNNTraining() {
      isTrainingNN = false;
      if (trainingInterval) clearInterval(trainingInterval);
      document.getElementById('nn-train-btn').innerHTML = `<i data-lucide="play" class="w-3.5 h-3.5"></i> Play Sim`;
      lucide.createIcons();
    }

    function resetNNSimulator() {
