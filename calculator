<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sahil Thote Calculator</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, sans-serif;
        }

        body{
            height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            background:linear-gradient(to right,#141e30,#243b55);
        }

        /* Calculator Box */

        .calculator{
            background:#0f172a;
            padding:25px;
            border-radius:20px;
            box-shadow:0 0 25px rgba(0,0,0,0.5);
            width:350px;
        }

        /* Title */

        .title{
            text-align:center;
            color:#00e5ff;
            margin-bottom:20px;
            font-size:28px;
            text-shadow:0 0 10px #00e5ff;
        }

        /* Display */

        #display{
            width:100%;
            height:70px;
            border:none;
            outline:none;
            border-radius:15px;
            background:#1e293b;
            color:white;
            text-align:right;
            padding:15px;
            font-size:32px;
            margin-bottom:20px;
            box-shadow:inset 0 0 10px rgba(0,0,0,0.4);
        }

        /* Buttons Grid */

        .buttons{
            display:grid;
            grid-template-columns:repeat(4,1fr);
            gap:15px;
        }

        button{
            height:65px;
            border:none;
            border-radius:15px;
            font-size:22px;
            cursor:pointer;
            transition:0.3s;
            font-weight:bold;
        }

        button:hover{
            transform:scale(1.08);
        }

        /* Number Buttons */

        .num{
            background:#334155;
            color:white;
        }

        .num:hover{
            background:#475569;
        }

        /* Operator Buttons */

        .operator{
            background:#00bcd4;
            color:black;
        }

        .operator:hover{
            background:#00e5ff;
        }

        /* Equal Button */

        .equal{
            background:#22c55e;
            color:white;
            grid-column:span 2;
        }

        .equal:hover{
            background:#16a34a;
        }

        /* Clear Button */

        .clear{
            background:#ef4444;
            color:white;
        }

        .clear:hover{
            background:#dc2626;
        }

        /* Footer */

        .footer{
            text-align:center;
            margin-top:20px;
            color:#cbd5e1;
            font-size:14px;
        }

    </style>
</head>

<body>

    <!-- Calculator -->

    <div class="calculator">

        <h1 class="title">Sahil Thote Calculator</h1>

        <!-- Display -->

        <input type="text" id="display" readonly>

        <!-- Buttons -->

        <div class="buttons">

            <button class="clear" onclick="clearDisplay()">C</button>

            <button class="operator" onclick="deleteLast()">⌫</button>

            <button class="operator" onclick="appendValue('%')">%</button>

            <button class="operator" onclick="appendValue('/')">÷</button>

            <button class="num" onclick="appendValue('7')">7</button>

            <button class="num" onclick="appendValue('8')">8</button>

            <button class="num" onclick="appendValue('9')">9</button>

            <button class="operator" onclick="appendValue('*')">×</button>

            <button class="num" onclick="appendValue('4')">4</button>

            <button class="num" onclick="appendValue('5')">5</button>

            <button class="num" onclick="appendValue('6')">6</button>

            <button class="operator" onclick="appendValue('-')">−</button>

            <button class="num" onclick="appendValue('1')">1</button>

            <button class="num" onclick="appendValue('2')">2</button>

            <button class="num" onclick="appendValue('3')">3</button>

            <button class="operator" onclick="appendValue('+')">+</button>

            <button class="num" onclick="appendValue('0')">0</button>

            <button class="num" onclick="appendValue('.')">.</button>

            <button class="equal" onclick="calculate()">=</button>

        </div>

        <!-- Footer -->

        <div class="footer">

            <p>© 2026 Sahil Thote | Calculator Project</p>

        </div>

    </div>

    <!-- JavaScript -->

    <script>

        let display = document.getElementById("display");

        // Add Value

        function appendValue(value){
            display.value += value;
        }

        // Clear Display

        function clearDisplay(){
            display.value = "";
        }

        // Delete Last Character

        function deleteLast(){
            display.value = display.value.slice(0,-1);
        }

        // Calculate Result

        function calculate(){

            try{
                display.value = eval(display.value);
            }

            catch{
                display.value = "Error";
            }

        }

    </script>

</body>
</html>
