<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sahil Thote | Landing Page</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Poppins',sans-serif;
            scroll-behavior:smooth;
        }

        body{
            background:#0f172a;
            color:white;
            overflow-x:hidden;
        }

        /* Navbar */

        header{
            width:100%;
            padding:20px 8%;
            display:flex;
            justify-content:space-between;
            align-items:center;
            position:fixed;
            top:0;
            z-index:1000;
            background:rgba(0,0,0,0.4);
            backdrop-filter:blur(10px);
        }

        header h1{
            color:#00e5ff;
            font-size:32px;
            text-shadow:0 0 10px #00e5ff;
        }

        nav a{
            color:white;
            text-decoration:none;
            margin-left:25px;
            font-size:18px;
            transition:0.3s;
            position:relative;
        }

        nav a:hover{
            color:#00e5ff;
        }

        nav a::after{
            content:'';
            position:absolute;
            width:0%;
            height:2px;
            background:#00e5ff;
            left:0;
            bottom:-5px;
            transition:0.4s;
        }

        nav a:hover::after{
            width:100%;
        }

        /* Hero Section */

        .hero{
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            padding:120px 8%;
            gap:60px;
            flex-wrap:wrap;
            background:linear-gradient(to right,#0f172a,#1e293b);
        }

        .hero-text{
            flex:1;
            min-width:300px;
        }

        .hero-text h2{
            font-size:65px;
            line-height:1.2;
            margin-bottom:20px;
        }

        .hero-text span{
            color:#00e5ff;
            text-shadow:0 0 15px #00e5ff;
        }

        .hero-text p{
            font-size:18px;
            line-height:1.8;
            margin-bottom:30px;
            color:#d1d5db;
        }

        .btn{
            display:inline-block;
            padding:15px 35px;
            background:#00e5ff;
            color:black;
            border-radius:40px;
            text-decoration:none;
            font-weight:bold;
            transition:0.4s;
            box-shadow:0 0 20px #00e5ff;
        }

        .btn:hover{
            transform:translateY(-5px) scale(1.05);
            background:white;
        }

        /* Hero Image */

        .hero-image{
            flex:1;
            text-align:center;
            min-width:300px;
        }

        .hero-image img{
            width:350px;
            height:350px;
            object-fit:cover;
            border-radius:50%;
            border:6px solid #00e5ff;
            box-shadow:0 0 40px #00e5ff;
            animation:float 3s ease-in-out infinite;
        }

        @keyframes float{
            0%{
                transform:translateY(0px);
            }
            50%{
                transform:translateY(-15px);
            }
            100%{
                transform:translateY(0px);
            }
        }

        /* Skills */

        .skills{
            padding:100px 8%;
            background:#111827;
            text-align:center;
        }

        .skills h2{
            font-size:45px;
            margin-bottom:50px;
            color:#00e5ff;
        }

        .skill-boxes{
            display:flex;
            flex-wrap:wrap;
            justify-content:center;
            gap:30px;
        }

        .box{
            width:280px;
            padding:35px;
            background:#1e293b;
            border-radius:20px;
            transition:0.4s;
            box-shadow:0 0 10px rgba(0,0,0,0.4);
        }

        .box:hover{
            transform:translateY(-10px);
            box-shadow:0 0 20px #00e5ff;
        }

        .box h3{
            margin-bottom:15px;
            color:#00e5ff;
        }

        /* About */

        .about{
            padding:100px 8%;
            text-align:center;
            background:#0f172a;
        }

        .about h2{
            font-size:45px;
            margin-bottom:30px;
            color:#00e5ff;
        }

        .about p{
            max-width:900px;
            margin:auto;
            font-size:18px;
            line-height:2;
            color:#d1d5db;
        }

        /* Contact */

        .contact{
            padding:100px 8%;
            text-align:center;
            background:#111827;
        }

        .contact h2{
            font-size:45px;
            margin-bottom:30px;
            color:#00e5ff;
        }

        .contact p{
            margin:15px 0;
            font-size:20px;
            color:#d1d5db;
        }

        /* Footer */

        footer{
            background:black;
            text-align:center;
            padding:20px;
            color:white;
        }

        /* Responsive */

        @media(max-width:900px){

            .hero{
                flex-direction:column-reverse;
                text-align:center;
            }

            .hero-text h2{
                font-size:45px;
            }

            header{
                flex-direction:column;
            }

            nav{
                margin-top:15px;
            }
        }

    </style>
</head>

<body>

    <!-- Header -->

    <header>

        <h1>Sahil Thote</h1>

        <nav>
            <a href="#">Home</a>
            <a href="#">Skills</a>
            <a href="#">About</a>
            <a href="#">Contact</a>
        </nav>

    </header>

    <!-- Hero Section -->

    <section class="hero">

        <div class="hero-text">

            <h2>Hello, I'm <span>Sahil Thote</span></h2>

            <p>
                Passionate Web Developer and Artificial Intelligence & Data Science student
                from Yeshwantrao Chavan College of Engineering, Nagpur.
                I love creating modern, responsive, and interactive websites using HTML and CSS.
            </p>

            <a href="#" class="btn">Explore More</a>

        </div>

        <!-- Your Image -->

        <div class="hero-image">

            <img src="D92E31D0-A9F2-4A32-B1D6-B2E014DB65C5.png" alt="Sahil Thote">

        </div>

    </section>

    <!-- Skills Section -->

    <section class="skills">

